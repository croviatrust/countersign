 "headline_numbers": {
  "signed_observations": {
   "source": "/registry/data/_home_pulse.json",
   "path": "ledger.n_envelopes_total",
   "valid": true
  },
  "bitcoin_anchors": {
   "source": "/registry/data/_home_pulse.json",
   "path": "anchors.distinct_roots",
   "valid": true,
   "rule": "distinct merkle_root with a confirmed Bitcoin timestamp; re-anchors of an unchanged root do not count"
  },
  "silence_days": {
   "source": "/registry/data/silence_index.json",
   "path": "total_silence_days",
   "valid": true,
   "rule": "observation-bounded: sum over targets of days between consecutive negative anchored observations; shown only in the 2026 archive section with 'observation paused 2026-06-01'"
  },
  "lacuna_records": {
   "source": "/registry/data/_home_pulse.json",
   "path": "ledger.by_axiom_type.AX.LAC",
   "valid": false,
   "rule": "target_id must be an AI model id (org/model), not an internal collector, path or test id; since 2026-09-19 the home page no longer shows this number — LACUNA candidates are read from TACET targets.json (negative_anchored_epochs)"
  },
  "tacet_epochs": {
   "source": "/registry/data/tacet/latest.json",
   "path": "epochs",
   "valid": true,
   "rule": "one signed epoch sheet per hour since genesis; anchored count shown alongside from anchored_epochs"
  },
  "tacet_models": {
   "source": "/registry/data/tacet/targets.json",
   "path": "count",
   "valid": true,
   "rule": "distinct target ids with at least one signed snapshot"
  },
  "tacet_negative_snapshots": {
   "source": "/registry/data/tacet/latest.json",
   "path": "negative_snapshots_total",
   "valid": true,
   "rule": "snapshots whose predicate result is false; counts toward silence only once the epoch is anchored"
  }
 },
